#!/bin/sh
# tb335-video-browser —— 一键「浏览器视频模式」
#
#   1) 切到 GPU 模式（glamor），此时浏览器视频用 GPU 合成，流畅无撕裂
#   2) 打开 Firefox
#   3) Firefox 全部关掉后，自动切回 CPU 模式（桌面恢复轻快）
#
# 说明：切换模式必须重启 Xorg，所以不能「检测到视频就切」——那样会把正在播的浏览器一起杀掉。
#       只能在进入/退出浏览器时切换。
LOG=/tmp/tb335-video-browser.log
exec >>"$LOG" 2>&1
echo "=== $(date -Is) 进入浏览器视频模式 ==="

export DISPLAY=:0
export XDG_RUNTIME_DIR=/run/user/0
export HOME=/root

# 1) 切 GPU
if ! /usr/local/bin/tb335-gpu-mode on; then
	echo "GPU 模式切换失败，放弃"
	exit 1
fi

# 2) 等桌面会话起来
i=0
while [ $i -lt 40 ]; do
	pgrep -x xfce4-session >/dev/null 2>&1 && break
	sleep 1
	i=$((i+1))
done
sleep 2

echo "--- 启动 Firefox ---"
setsid firefox-esr >/dev/null 2>&1 &

# 3) 等 Firefox 出现（最多 180 秒）
j=0
while [ $j -lt 180 ] && ! pgrep -x firefox-esr >/dev/null 2>&1; do
	sleep 2
	j=$((j+2))
done

if pgrep -x firefox-esr >/dev/null 2>&1; then
	echo "--- Firefox 已启动，等待其退出 ---"
	while pgrep -x firefox-esr >/dev/null 2>&1; do
		sleep 3
	done
else
	echo "--- Firefox 没起来，先保持 GPU 模式 3 分钟 ---"
	sleep 180
fi

# 4) 切回 CPU
echo "=== $(date -Is) 切回 CPU 模式 ==="
/usr/local/bin/tb335-gpu-mode off
echo "=== $(date -Is) 完成 ==="
